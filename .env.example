# Telegram Milk Billing Bot - Environment Variables Example

# The bot token you received from BotFather (Required)
BOT_TOKEN=8556577756:AAGn_5oMoOyzDW9IpktSVnK1y-Fmj-m4YJ0

# Comma-separated list of Telegram user/chat IDs allowed to perform admin tasks (e.g. /setrate, /close, /delete)
# Example: ADMIN_TELEGRAM_ID=752824992 or ADMIN_TELEGRAM_ID=752824992,123456789
ADMIN_TELEGRAM_ID=752824992

# Default milk rate per liter when database is first created (Optional, default is 65)
DEFAULT_RATE=65

# Relative or absolute path to the SQLite database file (Optional, default is data/milk.db)
DATABASE_PATH=data/milk.db
